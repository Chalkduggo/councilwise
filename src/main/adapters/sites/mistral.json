{
  "id": "mistral",
  "name": "Mistral Le Chat",
  "maker": "Mistral AI",
  "monogram": "MI",
  "url": "https://chat.mistral.ai/chat",
  "selectors": {
    "input": [
      "textarea",
      "[contenteditable=\"true\"]"
    ],
    "send": [
      "button[aria-label*=\"Send\" i]",
      "button[type=\"submit\"]"
    ],
    "busy": [
      "button[aria-label*=\"Stop\" i]"
    ],
    "response": [
      "[data-message-author-role=\"assistant\"]",
      ".prose"
    ],
    "fileInput": [
      "input[type=\"file\"]"
    ],
    "loggedOut": [
      "a[href*=\"/login\"]",
      "a[href*=\"auth\"]"
    ]
  },
  "plan": {
    "free": [
      "Upgrade to Pro",
      "Upgrade"
    ],
    "pro": [
      "Le Chat Pro",
      "Le Chat Team",
      "Le Chat Enterprise"
    ]
  },
  "upload": {
    "supported": true,
    "maxMB": 50
  },
  "pasteLimit": 40000,
  "webAccess": true,
  "privacyUrl": "https://admin.mistral.ai/",
  "privacyHint": "Settings \u2192 Privacy \u2192 turn off training on your chats.",
  "api": {
    "baseUrl": "https://api.mistral.ai/v1",
    "model": "mistral-large-latest"
  },
  "version": "2026.10.1"
}