{
  "id": "chatgpt",
  "name": "ChatGPT",
  "maker": "OpenAI",
  "monogram": "GP",
  "url": "https://chatgpt.com/",
  "selectors": {
    "input": [
      "#prompt-textarea",
      "div[contenteditable=\"true\"]",
      "textarea"
    ],
    "send": [
      "button[data-testid=\"send-button\"]",
      "button[aria-label*=\"Send\" i]"
    ],
    "busy": [
      "button[data-testid=\"stop-button\"]",
      "button[aria-label*=\"Stop\" i]"
    ],
    "response": [
      "[data-message-author-role=\"assistant\"]"
    ],
    "fileInput": [
      "input[type=\"file\"]"
    ],
    "loggedOut": [
      "button[data-testid=\"login-button\"]",
      "a[href*=\"auth/login\"]"
    ]
  },
  "plan": {
    "free": [
      "Upgrade plan",
      "Get Plus",
      "Upgrade to Plus",
      "Free plan"
    ],
    "pro": [
      "ChatGPT Plus",
      "ChatGPT Pro",
      "Plus plan",
      "Pro plan",
      "Team plan",
      "Business plan"
    ]
  },
  "upload": {
    "supported": true,
    "maxMB": 50
  },
  "pasteLimit": 60000,
  "webAccess": true,
  "privacyUrl": "https://chatgpt.com/#settings/DataControls",
  "api": {
    "baseUrl": "https://api.openai.com/v1",
    "model": "gpt-5"
  },
  "version": "2026.10.1"
}